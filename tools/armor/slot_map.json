{
  "_doc": "Each built outfit piece's slot (tools/assets/heroine_outfits.py, docs/handoff/armor.md section 1). Per outfit, entries: a slot, the slots it covers, and regexes matched in full against the piece's name after '<outfit>.'. Every piece must match exactly one entry, or the build fails naming it. Riders (trims, binds, stitches, rivets, clasps, laces) go with the piece they sit on. 'ink' (layer 0) is not a garment: the reaver's tattoos, worn on her skin.",
  "order": ["bottom", "top", "legwear", "gloves", "boots", "skirt", "collar", "bracers", "greaves", "belt", "pauldrons", "cloak", "head"],
  "_order_doc": "The garment tuck's slots, innermost first (docs/armor/PIECE_SCHEMA.md 'Garment tuck'; Rpg/GarmentTuck.cs Order, pinned to this by a test): a worn piece lies down under any later one not of its own outfit. Ink takes no part.",
  "layers": {
    "ink": 0,
    "top": 1, "bottom": 1, "legwear": 1, "gloves": 1,
    "skirt": 2, "belt": 2, "collar": 2, "bracers": 2, "greaves": 2, "boots": 2,
    "pauldrons": 3, "cloak": 3, "head": 3
  },
  "outfits": {
    "warden": [
      {"slot": "top", "match": ["cups(_.*)?", "strap[01](_.*)?", "backstrap(_.*)?", "strap_rivets", "gore(_.*)?"]},
      {"slot": "belt", "match": ["belt(_.*)?", "buckle(_.*)?"]},
      {"slot": "bottom", "match": ["thong(_.*)?"]},
      {"slot": "skirt", "match": ["skirt[01]_\\d+(_.*)?", "skirt_rivets"]},
      {"slot": "pauldrons", "match": ["pauldron_[lr](_.*)?"]},
      {"slot": "bracers", "match": ["vambrace_[lr](_.*)?"]},
      {"slot": "greaves", "match": ["greave_[lr](_.*)?", "knee_[lr](_.*)?"]},
      {"slot": "boots", "match": ["sabaton_[lr](_.*)?"]}
    ],
    "arcanist": [
      {"slot": "top", "match": ["corset(_.*)?", "clasp(_.*)?", "boning[a-d](_.*)?"], "under": ["plate_gstring_plain"]},
      {"slot": "bottom", "match": ["thong(_.*)?"]},
      {"slot": "collar", "match": ["choker(_.*)?"]},
      {"slot": "head", "match": ["hat_.*"]},
      {"slot": "gloves", "match": ["glove_[lr](_.*)?"]},
      {"slot": "legwear", "match": ["stocking_[lr](_.*)?", "lace_[lr](_.*)?"]},
      {"slot": "boots", "match": ["boot_[lr](_.*)?", "cuff_[lr](_.*)?"]}
    ],
    "ranger": [
      {"slot": "top", "match": ["corset(_.*)?", "eyelets(_.*)?", "lace_foot", "lace\\d[ab]", "lace_top[ab]", "bow[ab]", "tail[ab]", "aglet[ab]", "lace_knot"]},
      {"slot": "belt", "match": ["belt(_.*)?", "buckle"]},
      {"slot": "bottom", "covers": ["bottom", "legwear"], "match": ["pant(_.*)?", "thighstrap2?(_.*)?", "thighbuckle2?"]},
      {"slot": "pauldrons", "match": ["spaulder(_.*)?", "pauldron\\d(_.*)?"]},
      {"slot": "bracers", "match": ["bracer_[lr](_.*)?"]},
      {"slot": "gloves", "match": ["glove_[lr](_.*)?"]},
      {"slot": "boots", "match": ["boot_[lr](_.*)?", "cuff_[lr](_.*)?", "bootlace\\d[ab]"]}
    ],
    "reaver": [
      {"slot": "top", "match": ["strap(_.*)?"]},
      {"slot": "belt", "match": ["belt(_.*)?", "buckle"]},
      {"slot": "skirt", "match": ["loin_front(_.*)?"]},
      {"slot": "collar", "match": ["cord", "fangs"]},
      {"slot": "bottom", "match": ["gstring(_.*)?"]},
      {"slot": "cloak", "match": ["cape(_.*)?"]},
      {"slot": "ink", "match": ["tattoo_.*"]},
      {"slot": "bracers", "match": ["bracer_[lr](_.*)?", "wristfur_[lr](_.*)?"]},
      {"slot": "boots", "match": ["boot_[lr](_.*)?", "bootfur_[lr](_.*)?"]}
    ]
  }
}
