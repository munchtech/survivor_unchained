{
  "name": "survivor-unchained",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A persistent, emergent ARPG built on Survivors-style automated combat. Beta vertical slice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node tools/assets/build.mjs",
    "shot": "node tools/shot.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "SU_DEV_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win-installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "meshoptimizer": "^1.3.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "desktop/main.cjs",
  "author": "Munchtech",
  "build": {
    "appId": "com.munchtech.survivorunchained",
    "productName": "Survivor Unchained",
    "copyright": "Munchtech",
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "desktop/icon.png",
      "executableName": "survivor-unchained"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Survivor Unchained"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.role-playing-games",
      "icon": "desktop/icon.png"
    }
  }
}
