<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>SurvivorUnchained</RootNamespace>
  </PropertyGroup>
  <!-- (P2 task 5, session 3) The exported game's own code and the Godot binding precompiled (ReadyToRun): no first-call
       JIT in play. Exports only (the editor build stays IL for hot reload). Needs the Crossgen2 pack in the NuGet cache. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease' Or '$(Configuration)' == 'ExportDebug'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- The logic's tests are their own project (tests/Tests.csproj). -->
    <Compile Remove="tests/**" />
    <!-- So is the balance harness (balance/Balance.csproj). -->
    <Compile Remove="balance/**" />
  </ItemGroup>
</Project>
