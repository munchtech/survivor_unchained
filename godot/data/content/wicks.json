{
  // The Wicks (docs/design/CLASS_IDENTITY_AND_TALENTS.md 3.3): every skill's own small tree, 12 lamps in three
  // strands of four, the fourth a Turn. Read by Content/Wicks.cs; WickBook plans them, Sim/Turns.cs fights them.
  // A strand's lamps are "<strand>.1" to "<strand>.3" (lead-ins) and "<strand>.4" (its Turn).

  // The lead-ins every library strand of a kind shares. Increases add: two +10% damage lamps are +20%.
  // "area" with "projectileSpeed": a projectile skill takes the speed instead of the area.
  // School lead-ins act on the strand's Turn's status: "statusChance" is the chance a hit applies it,
  // "vsStatus" more damage to what has it, "statusDuration" more of its time.
  "leadIns": {
    "shape": [
      { "text": "+10% damage", "damage": 0.10 },
      { "text": "+10% area (projectiles: +15% speed)", "area": 0.10, "projectileSpeed": 0.15 },
      { "text": "8% shorter cooldown", "cooldown": -0.08 }
    ],
    "school": [
      { "text": "15% chance to {status}", "statusChance": 0.15 },
      { "text": "+10% damage to {statused} enemies", "vsStatus": 0.10 },
      { "text": "{Status} lasts 15% longer", "statusDuration": 0.15 }
    ],
    "bind": [
      { "text": "+10% damage", "damage": 0.10 },
      { "text": "+10% damage to champions", "vsChampion": 0.10 },
      { "text": "8% shorter cooldown", "cooldown": -0.08 }
    ]
  },

  // The Turns, built once (Sim/Turns.cs). Multipliers: projectiles, damage, area, cooldown. Counts add: chains,
  // bounces. "ground": what it leaves where it strikes (its school's ground). "school": it becomes that school,
  // and "status" is that school's status (what its lead-ins and a converted status give).
  // "pulses": it goes off that many times in all, "pulseGap" seconds apart (its damage and area are each pulse's).
  // "onKill": a kill by its own hit fires it once more from the corpse at "onKillDamage", at most once every
  // "onKillGap" seconds; an echo's kills never echo.
  // "heavyEvery": its own heavy count becomes every that many firings (a skill with a count of its own: Sunder).
  // "again": its blow lands again on the same spot that many seconds later, at "againDamage" (Groundbreaker's heave).
  // A calling skill's bespoke Turn is named for its strand ("sunder.stroke").
  "turns": {
    "split":  { "name": "Split",  "text": "Three smaller: three times the projectiles, each 28% damage and 75% size.", "projectiles": 3, "damage": 0.28, "area": 0.75 },
    "chain":  { "name": "Chain",  "text": "It bounces twice more, at 85% damage.", "chains": 2, "bounces": 2, "damage": 0.85 },
    "wide":   { "name": "Wide",   "text": "Bigger and slower: 20% larger, 30% longer cooldown, 15% less damage.", "area": 1.2, "cooldown": 1.3, "damage": 0.85 },
    "linger": { "name": "Linger", "text": "It leaves 1.5 m of its own ground for 2 s, burning at 25% of its damage a second.", "ground": { "radius": 1.5, "duration": 2, "dpsPct": 0.25 } },
    "pulse":  { "name": "Pulse",  "text": "It goes off three times, 0.3 s apart, each at 70% damage and 85% size.", "pulses": 3, "pulseGap": 0.3, "damage": 0.7, "area": 0.85 },
    "onkill": { "name": "On-kill", "text": "It fires again from what it kills, at 30% damage (once every 0.5 s at most).", "onKill": true, "onKillGap": 0.5, "onKillDamage": 0.3 },
    "fire":   { "name": "Fire",   "text": "It becomes fire: it burns, and strikes 10% harder.", "damage": 1.1, "school": "fire", "statused": "burning", "status": { "kind": "burn", "chance": 1, "power": 0.8, "duration": 3 } },
    "frost":  { "name": "Frost",  "text": "It becomes frost: it chills, and strikes 10% harder.", "damage": 1.1, "school": "frost", "statused": "chilled", "status": { "kind": "chill", "chance": 1, "power": 1, "duration": 2.5 } },
    "holy":   { "name": "Holy",   "text": "It becomes holy: it sears (dazzled for a moment; holy strikes it harder), and strikes 10% harder.", "damage": 1.1, "school": "holy", "statused": "seared", "status": { "kind": "sear", "chance": 1, "power": 0.5, "duration": 1 } },
    "sunder.stroke":            { "name": "Splitting Stroke", "text": "Every 2nd swing is heavy and splits the ground; swings 15% slower.", "heavyEvery": 2, "cooldown": 1.15 },
    "groundbreaker.aftershock": { "name": "Aftershock", "text": "0.8 s later the heave strikes the same spot again at 35%, stunning again.", "again": 0.8, "againDamage": 0.35 },
    "rebuke.morning":           { "name": "Shield of Morning", "text": "Each rebuke strike leaves you a barrier of 0.1% of health for each creature it strikes.", "barrierEach": 0.001, "barrierMost": 0.004 },
    "watch_bell.stone":         { "name": "Stone Bell", "text": "Each toll lays two stones, and each champion it draws lays one more.", "stones": 2, "stonesChampion": 1 },
    // Bladestorm (her key 3 at level 5): its calling strand breaks harder, its own shape strand reaches further. The
    // storm drains Resolve and has no wait in the campaign, so its lamps carry no cooldown (it would light nothing).
    "bladestorm.lines": { "name": "Line on Line", "text": "Every 2nd turn of the storm throws a Sunder line, not every 4th; its cuts, lines and break strike 20% lighter.", "heavyEvery": 2, "damage": 0.8 },
    "bladestorm.long":  { "name": "Long Blade", "text": "The storm reaches 30% further, and so do its lines and its break; its cuts, lines and break strike 20% lighter.", "area": 1.3, "damage": 0.8 },
    "bladestorm.hold":  { "name": "Hold Fast", "text": "Every cut of the storm chills what it strikes for 3 s; the 5th cut on one creature freezes it where it stands (a boss staggers instead)." }
  },

  // The library's strands: kind, Turn, lead-ins, and which skills it suits. "suits" is a list of alternatives,
  // each matching on behavior (any listed), tags (any listed) and "splash" (an explosion); absent, everything.
  // A school strand never suits a skill already of its school.
  "strands": {
    "split":  { "kind": "shape", "turn": "split",  "suits": [ { "tags": ["projectile"], "behaviors": ["aimed", "spray", "ring", "bounce", "chakram"] } ] },
    "chain":  { "kind": "shape", "turn": "chain",  "suits": [ { "tags": ["projectile"], "behaviors": ["aimed", "spray", "ring", "bounce", "chakram"] }, { "behaviors": ["chain", "bounce"] } ] },
    "wide":   { "kind": "shape", "turn": "wide",   "suits": [ { "behaviors": ["slash", "nova", "zone", "crack", "toll"] }, { "behaviors": ["aimed"], "splash": true } ] },
    "linger": { "kind": "shape", "turn": "linger", "suits": [ { "behaviors": ["aimed", "slash", "nova", "crack"] }, { "splash": true } ] },
    "pulse":  { "kind": "shape", "turn": "pulse",  "suits": [ { "behaviors": ["nova", "zone", "aimed", "toll"] } ] },
    "onkill": { "kind": "bind",  "turn": "onkill", "suits": [ { "behaviors": ["aimed", "spray", "ring", "nova", "zone", "chain", "storm", "bounce", "beam", "palm", "herd", "chakram", "slash", "reactive"] } ] },
    "fire":   { "kind": "school", "turn": "fire" },
    "frost":  { "kind": "school", "turn": "frost" },
    "holy":   { "kind": "school", "turn": "holy" }
  },

  // Each skill's three strands and the one Light my way follows first. "own" defines a bespoke strand for this
  // skill alone (same fields as a library strand, its lead-ins written out in "lamps").
  "skills": {
    "oathblade":      { "strands": ["wide", "linger", "holy"], "suggested": "wide" },
    "judgement_disc": { "strands": ["chain", "split", "fire"], "suggested": "chain" },
    "dawnpulse":      { "strands": ["pulse", "linger", "fire"], "suggested": "pulse" },
    // The warden's calling skills: one bespoke strand ("calling") and two of the library's each (3.3).
    "sunder": { "strands": ["wide", "holy", "sunder.stroke"], "suggested": "sunder.stroke", "own": {
      "sunder.stroke": { "kind": "calling", "turn": "sunder.stroke", "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% reach (and the heavy line's)", "area": 0.10 },
        { "text": "8% less time between swings", "cooldown": -0.08 } ] } } },
    "groundbreaker": { "strands": ["wide", "linger", "groundbreaker.aftershock"], "suggested": "groundbreaker.aftershock", "own": {
      "groundbreaker.aftershock": { "kind": "calling", "turn": "groundbreaker.aftershock", "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% crack and heave size", "area": 0.10 },
        { "text": "8% shorter cooldown", "cooldown": -0.08 } ] } } },
    "rebuke": { "strands": ["fire", "onkill", "rebuke.morning"], "suggested": "rebuke.morning", "own": {
      "rebuke.morning": { "kind": "calling", "turn": "rebuke.morning", "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% strike size", "area": 0.10 },
        { "text": "+10% damage to champions", "vsChampion": 0.10 } ] } } },
    "watch_bell": { "strands": ["wide", "pulse", "watch_bell.stone"], "suggested": "watch_bell.stone", "own": {
      "watch_bell.stone": { "kind": "calling", "turn": "watch_bell.stone", "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% reach", "area": 0.10 },
        { "text": "8% shorter time between tolls", "cooldown": -0.08 } ] } } },
    // Bladestorm: three strands of its own, not one and two of the library's: the library's shape and bind lamps shorten a
    // cooldown the storm does not have in the campaign (it drains Resolve, no wait), and a library school Turn converts a
    // status the storm does not have (it would chill nothing). Hold Fast is a rule strand ("effects", one list a place:
    // Content/Wicks.cs OwnRules): its lamps are the generic skill.area and skill.status rules on Bladestorm alone.
    "bladestorm": { "strands": ["bladestorm.lines", "bladestorm.long", "bladestorm.hold"], "suggested": "bladestorm.lines", "own": {
      "bladestorm.lines": { "kind": "calling", "turn": "bladestorm.lines", "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% reach (and the lines' and the break's)", "area": 0.10 },
        { "text": "+10% damage to champions", "vsChampion": 0.10 } ] },
      "bladestorm.long": { "kind": "shape", "turn": "bladestorm.long", "suits": [ { "behaviors": ["spin"] } ], "lamps": [
        { "text": "+10% damage", "damage": 0.10 },
        { "text": "+10% reach (and the lines' and the break's)", "area": 0.10 },
        { "text": "+10% damage to champions", "vsChampion": 0.10 } ] },
      "bladestorm.hold": { "kind": "bind", "turn": "bladestorm.hold", "suits": [ { "behaviors": ["spin"] } ], "lamps": [
        { "text": "+5% reach (and the lines' and the break's)" },
        { "text": "+5% reach (and the lines' and the break's)" },
        { "text": "+5% reach (and the lines' and the break's)" } ], "effects": [
        [ { "do": "rule", "rule": "skill.area", "args": { "skill": "bladestorm", "inc": 0.05 } } ],
        [ { "do": "rule", "rule": "skill.area", "args": { "skill": "bladestorm", "inc": 0.05 } } ],
        [ { "do": "rule", "rule": "skill.area", "args": { "skill": "bladestorm", "inc": 0.05 } } ],
        [ { "do": "rule", "rule": "skill.status", "args": { "skill": "bladestorm", "status": { "kind": "chill" } } } ] ] } } }
  }
}
