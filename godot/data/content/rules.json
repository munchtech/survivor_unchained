     },
     {
      "not": {
       "fact": "caravan.cargo",
       "exists": true
      }
     }
    ]
   },
   "effect": [],
   "report": "Harlan asked in the tavern whether anyone had seen a Coyle strongbox. Rook says he did not look at your door when he said it. He did not need to."
  },
