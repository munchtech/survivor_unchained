{
 "rules": [
  {
   "id": "dawn.voice",
   "once": true,
   "when": {
    "day": {
     "gte": 3
    }
   },
   "effect": [],
   "report": "Her voice is going the way her face went. You still have the word."
  },
  {
   "id": "dawn.word",
   "once": true,
   "when": {
    "day": {
     "gte": 6
    }
   },
   "effect": [],
   "report": "This morning it takes you a moment to find her word. It is there."
  },
  {
