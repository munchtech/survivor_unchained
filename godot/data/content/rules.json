   },
   "effect": [
    {
     "set": {
      "tam.farm": "raided"
     }
    },
    {
     "history": {
      "id": "farm_raided",
      "text": "Tam's father's farm was raided by the Pack",
      "tags": [
       "beasts"
      ],
      "spread": 2
     }
    },
    {
     "rel": {
      "npc": "tam",
      "trust": -10
     },
     "quiet": true
    }
   ],
   "report": "Tam's father did not come in last night. Holloway has sent two men out to the farm."
  },
  {
   "id": "beasts.farm_empty",
   "once": true,
   "when": {
    "all": [
     {
      "fact": "beasts.severity",
      "gte": 5
     },
     {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     },
     {
      "fact": "tam.pa_in",
      "eq": true
     },
     {
      "not": {
       "fact": "tam.farm",
       "exists": true
      }
     }
    ]
   },
   "effect": [
    {
     "set": {
      "tam.farm": "emptied"
     }
    },
    {
     "history": {
      "id": "farm_saved",
      "text": "fetched Tam's father in before the Pack hit his farm",
      "tags": [
       "beasts",
       "deed"
      ],
      "spread": 1,
      "reactions": {
       "tam": {
        "affection": 25,
        "trust": 20
       },
       "maeca": {
        "respect": 10
       }
      }
     }
    }
   ],
   "report": "The Pack hit the farm past the Old Road last night: pens open, the door in splinters. Nobody was home. Tam's Pa slept on Rook's floor and swore at you through breakfast."
  },
  {
   "id": "beasts.gate",
   "once": true,
   "when": {
    "all": [
     {
      "fact": "beasts.severity",
      "gte": 7
     },
     {
      "not": {
       "fact": "beasts.outcome",
