 },
 "caravanSettle": {
  "if": {
   "all": [
    {
     "fact": "caravan.survivors",
     "exists": true
    },
    {
     "fact": "caravan.cargo",
     "exists": true
    }
   ]
  },
  "then": {
   "quest": {
    "id": "caravan",
    "status": "resolved"
   }
  }
 }
