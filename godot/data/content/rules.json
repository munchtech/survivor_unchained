      "wolves.at_gate": true
     }
    },
    {
     "set": {
      "beasts.outcome": "ignored"
     }
    },
    {
     "quest": {
      "id": "beasts",
      "status": "failed",
      "outcome": "ignored"
     }
    },
    {
     "later": {
      "days": 1,
      "id": "aldo.buried",
      "effect": {
       "set": {
        "aldo.buried": true
       }
      }
     }
    }
   ],
   "report": "Wolves at the east gate in the night, a dozen of them, sick and bold. They had Aldo off the wall by his bad leg before anyone heard him shout. The Watch found most of him in the morning."
  },
  {
