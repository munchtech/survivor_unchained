// The ultimate's family (H7, docs/team/hook/H7_flare_ultimate.md; FLARE_LOOK §1.2, §1.5, §1.6): what every Strike Flare
// does before its blow, as data. The eight Strikes are instances; "flares" holds the few that need their own.
// Read by logic/Content/FlareFamily.cs; the view is Fx/Flare/FlareFx.Family.cs and Fx/Flare/FlareMarksView.cs.
{
  // The stop: from the press (after frame 1's answer) to the release the world's clock is held (worldRate), she is not.
  // Seconds of real time per calling; the clutch and a banked charge add a little; clamped to [min, max].
  "stop": {
    "calling": { "warden": 0.38, "arcanist": 0.36, "reaver": 0.32, "stalker": 0.27 },
    "clutch": 0.02, "banked": 0.02, "min": 0.25, "max": 0.40,
    "worldRate": 0.0,
    // The ordinary damage numbers and hit sparks already on screen fade out over this at the press.
    "hush": 0.06
  },
  // The grade: the world's materials fall toward moon indigo (LOOK_BIBLE rows 1-3), her ember the only warm light.
  // value: the world's albedo x; keep: how much of a material's own color stays (0 all indigo); tint: the shade's hue
  // (sRGB; normalised to unit luminance in the shader); lights: the world's own lamps, fires and windows x;
  // emit: emissive world materials x. in/out: seconds to fall at the press, to ease back after the release.
  "grade": {
    "in": 0.066, "out": 0.5,
    "night": { "value": 0.56, "keep": 0.35, "tint": "#7080c8", "lights": 0.25, "emit": 0.3 },
    "day":   { "value": 0.76, "keep": 0.5,  "tint": "#9aa6d8", "lights": 0.4,  "emit": 0.5 }
  },
  // The marks: a lit ring under every foe in Battle.FlareMarks, in Palette.Of(the Flare's school): light on the ground
  // hugging the foe's feet (LOOK_BIBLE row 8), under her in the read order (FLARE_LOOK §1.6: danger, her, the Flare's front).
  // scale: the ring's radius x the foe's; band: its one soft band's width (x the ring); pool: the faint pool inside it (x the
  // ring's light) and warm: how far the pool leans to her ember's warmth; ripple: seconds for the rings to appear from her
  // outward; pop: a struck ring's flash, growing popGrow x the ring and gone (no shade left); fade: an unhit ring's fade at the
  // cast's end; main: the hovered target's light x; pulse: its slow pulse (Hz); pillar: its thin light's height (m);
  // gain: an ordinary ring's light by night and day; cap: the most overlapping rings sum to (premultiplied: they converge on
  // it, never stack to white); dark: the soft shade just outside a ring (it holds by day over a pale ground);
  // strip: a line Flare's path seam's light, seamCore/seamGlow its core's and glow's half-widths (m), seamShimmer the
  // shimmer running out along it (Hz); rim: the marked foe's rim.
  "marks": {
    "scale": 1.15, "band": 0.07, "pool": 0.14, "warm": 0.45,
    "ripple": 0.1, "pop": 0.15, "popGrow": 0.45, "fade": 0.2,
    "main": 2.2, "pulse": 1.6, "pillar": 2.4,
    "seamCore": 0.09, "seamGlow": 0.45, "seamShimmer": 0.8,
    "night": { "gain": 0.5, "cap": 0.75, "dark": 0.12, "strip": 0.16 },
    "day":   { "gain": 0.9, "cap": 1.2, "dark": 0.3, "strip": 0.22 },
    "rim": 0.7
  },
  // The band (H7 beat 3; r2, judge r1 fix 2: "the band reads as nothing"): on each Flare's main blow a lit FRONT in the
  // school's glow (Palette.Of) runs from her (a line Flare: out from its line) past the frame's edges: reach m in time s of
  // Flare time, eased out by ease (at x of its run it stands at reach (1 - (1 - x)^ease)); at 22 m it clears the play
  // camera's corners (~20 m from her) by about 0.25 s. lead: its soft leading edge (m; the play camera shows the ground at
  // about 50-57 px a metre round her, so 0.55 m is ~30 px); the ground behind it stays lit for after s, at tail x the
  // front's light, falling to nothing (no dark wake); fade: the last share of its run it fades over. front: its light, x
  // the ground's albedo (light, not paint: a dark body stays dark), so the front reads about 2x the ground's value.
  // (Derived from the judge's ranked fix 2 and FLARE_LOOK §1.6 "the front travels ... 0.25 to 0.4 s"; r1's band was a 0.15
  // emissive tint over a 30 m run, read as nothing.)
  "band": {
    "reach": 22, "time": 0.28, "ease": 1.35, "lead": 0.55, "after": 0.15, "fade": 0.3,
    "night": { "front": 0.9, "tail": 0.4 },
    "day":   { "front": 0.6, "tail": 0.35 }
  },
  // The beat: the camera's kick on the main blow (px at 1080p, the first swing, FollowCamera.JoltPx); a drop lands
  // dropLag s after the band passes it, scaled in over dropGrow; a decision-marked hit's death and number wait
  // decisionFrames frames after its mark shows; the Flare's numbers come numberLag s after the band passes each foe.
  // spendLight(Day): the plain Strikes' Spend light on the main blow (an omni's energy, on real time: 2-3 frames at its peak).
  "beat": { "kickPx": 9, "dropLag": 0.05, "dropGrow": 0.3, "decisionFrames": 2, "numberLag": 0.02, "spendLight": 5, "spendLightDay": 6 },
  // The recovery: the grade eases back over grade.out from the main blow; her ember's pool at pool x for hold s, then
  // back over out s.
  "recovery": { "pool": 1.3, "hold": 2.0, "out": 0.4 },
  // The PEAK (H7 r2, judge r1 fix 1: "the blow beat was never built"): the main blow's 3-4 frames, lit FROM the blow in
  // dawn gold by a real light rig (omnis, not a full-screen flash), held by a hitstop of hitstop drawn frames (it replaces
  // the Strike's own on the main blow; its other blows keep theirs). frames: the rig's envelope by drawn frame from the
  // blow (real time, so the hitstop never holds it); FLARE_LOOK §1.6's caps: the frame's mean under 1.5x the pre-press for
  // 4 frames at most, once per Strike, at most 3% over the knee. color: the rig's light (sRGB). release: the press's
  // push-in lets go on the blow over this (s, Flare time). height/range: the rig's omnis (m; a line's sit low along it,
  // so the bodies on it are lit from below), spacing along a line (m), lights at most. night/day: light, an omni's energy at
  // the envelope's 1; ground, the lit shape's light (x albedo: the disk or the strip the blow lights); column, a disk's
  // column of light (HDR). Each Flare's shape is its own ("flares" peak).
  "peak": {
    "hitstop": 2, "frames": [0.85, 1.0, 1.0, 0.8, 0.4, 0.15],
    "color": "#ffbe6a", "release": 0.15,
    "height": 0.45, "range": 6.5, "spacing": 4.5, "lights": 6,
    "night": { "light": 7, "ground": 1.4, "column": 3.5 },
    "day":   { "light": 14, "ground": 1.0, "column": 4.5 }
  },
  // An air and dust ripple (Bell's first two tolls, judge r1 fix 2): no light, no whole-frame swing (§1.6: at most two a
  // second): a soft front lifting the ground's value by dust (x), lead m, running reach m in time s, and puffs of dust
  // thrown out along it.
  "ripple": { "reach": 10, "time": 0.25, "lead": 0.8, "dust": 0.35, "puffs": 28 },
  // Per Flare: stop (its own seconds), blow (its main blow: the Blow event's Part; last: only its last such), from (where
  // its band runs from: "her", or "line": out from the blow's line); peak: its peak's shape ("disk": radius m round where
  // it lands, a column m tall at its heart; "line": width m either side of its line, its whole length); ripple: the Blow
  // part whose earlier blows are an air and dust ripple; fuse: the Long Cut's fuse along its seam (m/s).
  // The Long Cut: its clip (tools/anim/clips/flare_long_cut.py, 30 fps on her clock) tops its arch at f12-13 (0.40-0.43 s)
  // and the whip starts; the release lands there, so the sweep's blow (0.1 s of Flare time later) meets the clip's contact
  // (f16.5, 0.545 s). Its fuse at 200 m/s opens the 24 m seam in 0.12 s, so the whole seam erupts on the peak (r1: 60,
  // 0.4 s, a slow fuse read as a gap between mark and hit).
  "flares": {
    "the_long_cut":        { "stop": 0.40, "blow": "cleave", "from": "line", "fuse": 200, "peak": { "shape": "line", "width": 2.5 } },
    "bell_of_the_morning": { "blow": "blast", "ripple": "toll", "peak": { "shape": "disk", "radius": 8, "column": 7 } },
    "burns_twice":         { "blow": "ember", "last": true },
    "the_roads_toll":      { "blow": "cut", "last": true },
    "the_branding":        { "blow": "burst", "last": true },
    "one_arrow":           { "blow": "arrow", "from": "line" },
    "drag_them_under":     { "blow": "slam" },
    "the_butchers_bill":   { "blow": "chop", "last": true }
  }
}
