// The ultimate's family (H7, docs/team/hook/H7_flare_ultimate.md; FLARE_LOOK §1.2, §1.5, §1.6): what every Strike Flare
// does before its blow, as data. The eight Strikes are instances; "flares" holds the few that need their own.
// Read by logic/Content/FlareFamily.cs; the view is Fx/Flare/FlareFx.Family.cs and Fx/Flare/FlareMarksView.cs.
{
  // The stop: from the press (after frame 1's answer) to the release the world's clock is held (worldRate), she is not.
  // Seconds of real time per calling; the clutch and a banked charge add a little; clamped to [min, max].
  "stop": {
    "calling": { "warden": 0.38, "arcanist": 0.36, "reaver": 0.32, "stalker": 0.27 },
    "clutch": 0.02, "banked": 0.02, "min": 0.25, "max": 0.40,
    "worldRate": 0.0,
    // The ordinary damage numbers and hit sparks already on screen fade out over this at the press.
    "hush": 0.06
  },
  // The grade: the world's materials fall toward moon indigo (LOOK_BIBLE rows 1-3), her ember the only warm light.
  // value: the world's albedo x; keep: how much of a material's own color stays (0 all indigo); tint: the shade's hue
  // (sRGB; normalised to unit luminance in the shader); lights: the world's own lamps, fires and windows x;
  // emit: emissive world materials x. in/out: seconds to fall at the press, to ease back after the release.
  // r2 (judge r1 fix 6: "the stop ~30% deeper in value"): value 0.56 -> 0.39 by night, 0.76 -> 0.53 by day; fx: the fight's
  // own lingering light (her rune circles, hallowed and burning ground, auras, shockwaves, ribbons, skill lights: BattleFx
  // FlareDim) x, so nothing of hers stays bright on the indigo (danger marks, group "fx_danger", stay full: §1.6's read
  // order); pool: her ember's pool x through the stop (bible rule 3: she is the only warm light), eased with the grade.
  "grade": {
    "in": 0.066, "out": 0.5, "pool": 1.5,
    "night": { "value": 0.39, "keep": 0.35, "tint": "#7080c8", "lights": 0.18, "emit": 0.21, "fx": 0.3 },
    "day":   { "value": 0.53, "keep": 0.5,  "tint": "#9aa6d8", "lights": 0.28, "emit": 0.35, "fx": 0.45 }
  },
  // The dust (r2, judge r1 fix 4, in the web's place): motes hanging frozen in the air over the field through the stop
  // (FlareFx.Dust; FlareBits' mote), told apart by their stillness: count over a box round her along the camera (across
  // x, near/far m), from low to high m over the ground, size m (min, max; a few glints at glint of them, glintSize x),
  // drift m/s (near-still, alive); light: a mote's light (a pale moon silver, cold), warm: within warmReach m of her they
  // take her ember's light (x warm, falling off); the band's front blows them out (gust m/s, up m/s, drag), lit as it
  // passes (flash x for flashTime s) and gone over gone s. Their light follows the grade in and out.
  "dust": {
    "count": 440, "across": 24, "near": 14, "far": 18, "low": 0.2, "high": 2.8,
    "size": [0.04, 0.1], "glint": 0.08, "glintSize": 1.6, "drift": 0.025,
    "color": "#b4c0f0", "warmColor": "#ffa860", "warmReach": 5,
    "night": { "light": 0.16, "warm": 0.7 },
    "day":   { "light": 0.22, "warm": 0.5 },
    "gust": 4.5, "up": 1.2, "drag": 2.5, "flash": 2.2, "flashTime": 0.1, "gone": 0.35
  },
  // The marks (r2, judge r1 fixes 3 and 5): a soft radial POOL of the school's light (Palette.Of) on the ground under every
  // foe in Battle.FlareMarks, no stroke and no edge (LOOK_BIBLE row 8: light hugging the feet; FLARE_LOOK §3.5: a gaussian
  // never makes an edge), under her in the read order (§1.6: danger, her, the Flare's front), with light up the body (lift).
  // size: the pool's radius at a quarter of its light, x the foe's radius: 1.5 makes it 1.5x the footprint across (judge r1
  // fix 5; 2.3 measured 177 px across on the Warden's wolves, ~115 px now);
  // falloff: its power (2 a gaussian, higher a flatter top); above: the quad's lift over HeightAt (m, depth-tested so the
  // body hides its heart); warm: how far the pool's heart leans to her ember's warmth; ripple: seconds for the pools to
  // appear from her outward; main: the hovered target's size AND light x, with an inner core (core: its radius x the
  // pool's, coreGain: its light x the pool's peak) and a slow breath (pulse, Hz), so it reads without a ray.
  // The hit (fix 3, "no gap between mark and hit"): a pool stays through the blow and TIGHTENS (tight: its size then x,
  // tightLight: its light then x) from the release (preTight of the way by the blow, easing in over preTime s) up to the
  // moment the band reaches its foe (FlareFx.BandReachesRt), then hands over to the band's rim in hand s; never a swell and
  // fade before the hit. fade: an unhit pool's fade at the cast's end.
  // gain: an ordinary pool's light by night and day, as a LIFT of what lies under it (x the graded ground: light, not paint;
  // r2 after f2e: an additive pool converged on a flat 0.7 gold and the pack's pools merged into one blown-out sheet);
  // (cap 2: a pack's overlaps sit at about one pool's heart, so a dense pack reads as lit bodies on a lit floor, not a
  // blob growing toward a sheet; the Main converges on main x it.)
  // cap: the most overlapping pools lift it (premultiplied: they converge on "the ground x (1 + cap)", never on white);
  // floor: the light a pool adds at the cap where the ground is near black (linear), so it still reads there; dark: the soft shade round a pool (it holds by day over a pale ground); strip: a line
  // Flare's path seam's light (the Long Cut draws its future crack instead: flares.the_long_cut.path), seamCore/seamGlow
  // its core's and glow's half-widths (m), seamShimmer its shimmer (Hz); rim: the marked foe's rim and uplight (vat's lift).
  "marks": {
    "size": 1.5, "falloff": 2.0, "above": 0.25, "warm": 0.3,
    "ripple": 0.1, "fade": 0.2,
    "main": 2.0, "core": 0.32, "coreGain": 1.4, "pulse": 1.6,
    "tight": 0.64, "tightLight": 1.7, "preTight": 0.3, "preTime": 0.25, "hand": 0.05,
    "seamCore": 0.09, "seamGlow": 0.45, "seamShimmer": 0.8,
    "night": { "gain": 1.3, "cap": 2.0, "floor": 0.025, "dark": 0.1, "strip": 0.6 },
    "day":   { "gain": 0.7, "cap": 1.0, "floor": 0.04, "dark": 0.25, "strip": 0.5 },
    "rim": 0.7, "lift": 0.9
  },
  // The band (H7 beat 3; r2, judge r1 fix 2: "the band reads as nothing"): on each Flare's main blow a lit FRONT in the
  // school's glow (Palette.Of) runs from her (a line Flare: out from its line) past the frame's edges: reach m in time s of
  // Flare time, eased out by ease (at x of its run it stands at reach (1 - (1 - x)^ease)); at 22 m it clears the play
  // camera's corners (~20 m from her) by about 0.25 s. lead: its soft leading edge (m; the play camera shows the ground at
  // about 50-57 px a metre round her, so 0.55 m is ~30 px); the ground behind it stays lit for after s, at tail x the
  // front's light, falling to nothing (no dark wake); fade: the last share of its run it fades over. front: its light, x
  // the ground's albedo (light, not paint: a dark body stays dark), so the front reads about 2x the ground's value.
  // (Derived from the judge's ranked fix 2 and FLARE_LOOK §1.6 "the front travels ... 0.25 to 0.4 s"; r1's band was a 0.15
  // emissive tint over a 30 m run, read as nothing.)
  // r3 (judge r2 fix 4, "only a faint lift of the floor", unreadable at 1:1): a thin gold-white LEADING EDGE, lead m of
  // rise ahead of the front and edge m of fall behind it (~8-14 px at 1080p, about 90 px a metre round her), its own glow
  // (HDR, x the front's colour: a dark floor has little to lift) over its light x albedo; then a darker TROUGH trough m
  // deep (the ground's albedo x 1 - dark); then the lit ground. ease 1.1 (was 1.35): the front stays on screen ~9 frames
  // (the frame's corners ~12.5 m from her). rimColor: the struck bodies' rim as it crosses them (gold, edge only).
  "band": {
    "reach": 22, "time": 0.28, "ease": 1.1, "lead": 0.06, "after": 0.15, "fade": 0.3,
    "edge": 0.07, "trough": 0.7, "dark": 0.35, "rimColor": "#ffb84a",
    "night": { "front": 0.9, "tail": 0.4, "glow": 0.3 },
    "day":   { "front": 0.6, "tail": 0.35, "glow": 0.4 }
  },
  // The beat: the camera's kick on the main blow (px at 1080p, the first swing, FollowCamera.JoltPx); a drop lands
  // dropLag s after the band passes it, scaled in over dropGrow; a decision-marked hit's death and number wait
  // decisionFrames frames after its mark shows; the Flare's numbers come numberLag s after the band passes each foe.
  // spendLight(Day): the plain Strikes' Spend light on the main blow (an omni's energy, on real time: 2-3 frames at its peak).
  "beat": { "kickPx": 8, "dropLag": 0.05, "dropGrow": 0.3, "decisionFrames": 2, "numberLag": 0.02, "spendLight": 5, "spendLightDay": 6 },
  // The recovery: the grade eases back over grade.out from the main blow; her ember's pool at pool x for hold s, then
  // back over out s.
  "recovery": { "pool": 1.3, "hold": 2.0, "out": 0.4 },
  // The PEAK (H7 r2, judge r1 fix 1: "the blow beat was never built"): the main blow's 3-4 frames, lit FROM the blow in
  // dawn gold by a real light rig (omnis, not a full-screen flash), held by a hitstop of hitstop drawn frames (it replaces
  // the Strike's own on the main blow; its other blows keep theirs). frames: the rig's envelope by drawn frame from the
  // blow (real time, so the hitstop never holds it); FLARE_LOOK §1.6's caps: the frame's mean under 1.5x the pre-press for
  // 4 frames at most, once per Strike, at most 3% over the knee. color: the rig's light (sRGB). release: the press's
  // push-in lets go on the blow over this (s, Flare time). height/range: the rig's omnis (m; a line's sit low along it,
  // so the bodies on it are lit from below), spacing along a line (m), lights at most. night/day: light, an omni's energy at
  // the envelope's 1; ground, the lit shape's light (x albedo: the disk or the strip the blow lights); column, a disk's
  // column of light (HDR); wash (r2 after f2e: the mean sat at 0.98x pre-press under the deeper grade, its light all in hot
  // cores that clip the knee before the mean moves): broad soft light round the shape, x albedo, reaching wide x the shape's
  // size (a line's half-width, a disk's radius; a gaussian); core: the shape's hot heart (x ground: the seam's narrow
  // core, the disk's middle, lit x albedo); hotDay: a Flare's hot heart by day x its night's. A Flare's own peak: hot, its hot
  // heart (hotWidth: its half-width along a line, its radius in a disk, m; flat-topped), an emitter (HDR, not x albedo: the graded albedo never clipped, the knee sat at 0.5%) along the line's crack or in
  // the disk's middle, the few pixels that carry §1.6's 2-3% over the knee. Each Flare's shape is its own ("flares" peak).
  "peak": {
    "hitstop": 2, "frames": [0.8, 1.0, 1.0, 0.7, 0.25, 0.06],
    "color": "#ffbe6a", "release": 0.15,
    "height": 0.45, "range": 6.5, "spacing": 4.5, "lights": 6, "wide": 2.5, "core": 5, "hotDay": 1.3,
    "night": { "light": 1.8, "ground": 0.25, "column": 6, "wash": 0 },
    "day":   { "light": 3.6, "ground": 0.22, "column": 7, "wash": 0 }
  },
  // An air and dust ripple (Bell's first two tolls, judge r1 fix 2): no light, no whole-frame swing (§1.6: at most two a
  // second): a soft front lifting the ground's value by dust (x), lead m, running reach m in time s, and puffs of dust
  // thrown out along it.
  "ripple": { "reach": 10, "time": 0.25, "lead": 0.8, "dust": 0.35, "puffs": 28 },
  // The foreshadow (r2, judge r1 fix 7; a line Flare whose path is "crack"): in the stop its future crack (the very strip the
  // cleave opens, flare_crack_b, along the marks' line) lit faintly from below, blurred (blur: the mip), in the seam's own
  // ember (heat: fl_seam_col's 0..1) at light x the ground's albedo by night and day, wandering wander along it; a spark
  // runs out along it from her (sparkTime s a run, from sparkFrom s after the press, again after sparkGap s), its head
  // sparkLight, its tail sparkTail m; in over in s, and gone into the cleave. (r1: the marks' seam, a hard laser hairline.)
  "foreshadow": {
    "blur": 3.0, "heat": 0.42, "wander": 0.5, "in": 0.08,
    "sparkTime": 0.42, "sparkFrom": 0.04, "sparkGap": 0.12, "sparkTail": 2.2,
    "night": { "light": 0.5, "sparkLight": 2.6 },
    "day":   { "light": 0.7, "sparkLight": 3.2 }
  },
  // Per Flare: stop (its own seconds), blow (its main blow: the Blow event's Part; last: only its last such), from (where
  // its band runs from: "her", or "line": out from the blow's line); peak: its peak's shape ("disk": radius m round where
  // it lands, a column m tall at its heart; "line": width m either side of its line, its whole length); ripple: the Blow
  // part whose earlier blows are an air and dust ripple; fuse: the Long Cut's fuse along its seam (m/s); path: how a line
  // Flare's path shows in the stop ("strip": the marks' seam; "crack": its future crack lit faintly from below with a spark
  // running along it, FlareFx.LongCut LcForeshadow and "foreshadow" below).
  // The Long Cut: its clip (tools/anim/clips/flare_long_cut.py, 30 fps on her clock) tops its arch at f12-13 (0.40-0.43 s)
  // and the whip starts; the release lands there, so the sweep's blow (0.1 s of Flare time later) meets the clip's contact
  // (f16.5, 0.545 s). Its fuse at 200 m/s opens the 24 m seam in 0.12 s, so the whole seam erupts on the peak (r1: 60,
  // 0.4 s, a slow fuse read as a gap between mark and hit). r3 (judge r2 fix 3): "from": "tear", its crack tears from her
  // in step with the band (its white-hot tip the band's front along the line; the fuse only for a cast with no band), the
  // peak light out of the crack itself: hot its core (HDR), spill its lips' gold (x albedo), tip the tear's tip (HDR),
  // along its rig's lights from her to the far end, each lit as the tear reaches it; frames its own envelope (the tear is
  // short on +1, so +1 and +3 carry more: 1.3-1.45x on +1..+3). (r2: hot 0.8 over a flat-topped bar
  // hotWidth 0.36 m either side of the straight line, a cream strip ~50 px tall.)
  "flares": {
    "the_long_cut":        { "stop": 0.40, "blow": "cleave", "from": "tear", "fuse": 200, "path": "crack", "peak": { "shape": "line", "width": 2.5, "gain": 1.2, "hot": 2.5, "spill": 8, "tip": 2.0, "along": [4.5, 1.2], "frames": [0.85, 1.3, 1.0, 0.9, 0.3, 0.06] } },
    "bell_of_the_morning": { "blow": "blast", "ripple": "toll", "peak": { "shape": "disk", "radius": 8, "column": 7, "gain": 1.25, "hot": 0.8, "hotWidth": 1.85 } },
    "burns_twice":         { "blow": "ember", "last": true },
    "the_roads_toll":      { "blow": "cut", "last": true },
    "the_branding":        { "blow": "burst", "last": true },
    "one_arrow":           { "blow": "arrow", "from": "line" },
    "drag_them_under":     { "blow": "slam" },
    "the_butchers_bill":   { "blow": "chop", "last": true }
  }
}
