   "paints": [
    {"id": "none", "name": "Bare", "words": "Her own face, nothing on it."},
    {"id": "kohl", "name": "Kohl", "words": "Soot and tallow smudged round the eyes and drawn out to a point.", "rough": 0.55},
    {"id": "rouge", "name": "Kohl and rouge", "words": "Kohl, and her lips stained the red of crushed rosehip.", "rough": 0.45},
    {"id": "woad", "name": "Woad", "words": "The old blue of the hill people, banded over her brow and down her cheeks.", "rough": 0.85},
    {"id": "ochre", "name": "Hunter's ochre", "words": "A band of red earth across the eyes, temple to temple, laid on with two fingers.", "rough": 0.8},
    {"id": "ash", "name": "Ash", "words": "Grey from a dead fire, thumbed under the eyes. Mourning, or a promise.", "rough": 0.9},
    {"id": "blood", "name": "Blood oath", "words": "Three fingers of blood drawn down over her left eye, brow to jaw.", "rough": 0.5},
    {"id": "gilt", "name": "Gilt", "words": "Gold leaf pressed along her cheekbones, torn at its edges.", "rough": 0.3, "metal": 1.0}
   ],
   "faces": [
    {"id": "own", "name": "As she is", "words": "Her own face, as the road left it.", "shape": {}, "skin": "fair", "eyes": "moss"},
    {"id": "highborn", "name": "Highborn", "words": "Fine-boned and narrow, a long straight nose: a face for a portrait in a hall.", "shape": {"face_width": -0.5, "face_shape": 0.3, "cheekbone_height": 0.6, "cheekbone_prominence": 0.6, "cheeks": -0.3, "nose_length": 0.4, "nose_width": -0.5, "nose_bridge": -0.3, "nose_tip_width": -0.4, "lips_upper": -0.25, "eyes_depth": -0.4, "eyes_height": -0.2, "brows_arch": -0.3, "brows_height": -0.2, "chin_width": -0.4, "chin_length": 0.2, "jaw_width": -0.4, "forehead_height": 0.3}, "skin": "fair", "eyes": "frost"},
    {"id": "vixen", "name": "Vixen", "words": "Eyes tilted up under heavy lids, a full mouth, a small sharp chin.", "shape": {"eyes_tilt": 0.8, "eyes_open": -0.45, "eyes_inner": 0.6, "cheekbone_width": 0.6, "cheekbone_height": 0.45, "cheeks": 0.1, "nose_length": -0.3, "nose_tip": 0.4, "nose_width": -0.3, "lips_upper": 0.35, "lips_lower": 0.45, "cupids_bow": 0.7, "mouth_corners": 0.3, "chin_width": -0.6, "jaw_width": -0.35, "brows_arch": 0.5}, "skin": "rose", "eyes": "flint"},
    {"id": "doe", "name": "Doe", "words": "Wide soft eyes, a small nose, a gentle jaw. People trust her before they should.", "shape": {"eyes_size": 0.7, "eyes_open": 0.35, "eyes_tilt": -0.1, "brows_arch": 0.45, "brows_height": 0.1, "jaw_angle": -0.5, "jaw_width": 0.15, "cheeks": 0.35, "face_shape": 0.4, "lips_lower": 0.45, "lips_upper": 0.2, "nose_length": -0.3, "nose_bridge": -0.2, "chin_length": -0.2}, "skin": "olive", "eyes": "peat"},
    {"id": "sunborn", "name": "Sunborn", "words": "Wide-set eyes, a full mouth, a face carved for the long light of the south roads.", "shape": {"eyes_spacing": 0.5, "eyes_size": 0.45, "nose_width": 0.8, "nose_bridge_width": 0.5, "nose_tip_width": 0.6, "nostrils": 0.6, "nose_projection": -0.3, "lips_upper": 0.7, "lips_lower": 0.8, "mouth_width": 0.3, "cheekbone_height": 0.35, "cheeks": 0.2, "forehead_round": 0.5, "face_shape": 0.3, "jaw_angle": -0.2}, "skin": "deep", "eyes": "sloe"},
    {"id": "moonlit", "name": "Moonlit", "words": "Almond eyes that give nothing away, a small mouth, skin like the inside of a shell.", "shape": {"eyes_inner": 0.85, "eyes_open": -0.5, "eyes_size": -0.15, "eyes_tilt": 0.3, "nose_bridge_width": 0.3, "nose_projection": -0.6, "nose_bridge": -0.4, "brow_ridge": -0.5, "brows_arch": -0.2, "cheeks": 0.25, "chin_width": -0.45, "mouth_width": -0.3, "lips_lower": 0.2, "forehead_round": 0.4, "face_shape": -0.3}, "skin": "warm", "eyes": "sloe"},
    {"id": "saffron", "name": "Saffron", "words": "Great dark eyes under strong brows, and a nose with a proud line to it.", "shape": {"eyes_size": 0.6, "brows_arch": 0.6, "brows_height": -0.1, "nose_bridge": 0.5, "nose_length": 0.3, "nose_tip": -0.2, "lips_lower": 0.5, "lips_upper": 0.3, "cheekbone_height": 0.3, "face_shape": 0.4, "eyes_depth": -0.3, "jaw_width": -0.2}, "skin": "brown", "eyes": "peat"},
    {"id": "wildling", "name": "Wildling", "words": "A wide mouth made for laughing, a broad nose, cheekbones from the hill country.", "shape": {"mouth_width": 0.7, "lips_upper": 0.4, "lips_lower": 0.6, "nose_tip_width": 0.5, "nose_width": 0.3, "cheeks": 0.4, "cheekbone_height": 0.4, "face_shape": -0.5, "mouth_corners": 0.4, "eyes_tilt": 0.2}, "skin": "warm", "eyes": "hazel"},
