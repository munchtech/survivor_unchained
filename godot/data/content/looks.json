   "paints": [
    {"id": "none", "name": "Bare", "words": "Her own face, nothing on it."},
    {"id": "kohl", "name": "Kohl", "words": "Soot and tallow smudged round the eyes and drawn out to a point.", "rough": 0.55},
    {"id": "rouge", "name": "Kohl and rouge", "words": "Kohl, and her lips stained the red of crushed rosehip.", "rough": 0.45},
    {"id": "woad", "name": "Woad", "words": "The old blue of the hill people, banded over her brow and down her cheeks.", "rough": 0.85},
    {"id": "ochre", "name": "Hunter's ochre", "words": "A band of red earth across the eyes, temple to temple, laid on with two fingers.", "rough": 0.8},
    {"id": "ash", "name": "Ash", "words": "Grey from a dead fire, thumbed under the eyes. Mourning, or a promise.", "rough": 0.9},
    {"id": "blood", "name": "Blood oath", "words": "Three fingers of blood drawn down over her left eye, brow to jaw.", "rough": 0.5},
    {"id": "gilt", "name": "Gilt", "words": "Gold leaf pressed along her cheekbones, torn at its edges.", "rough": 0.3, "metal": 1.0}
   ],
   "faces": [
    {"id": "own", "name": "As she is", "words": "Her own face, as the road left it.", "shape": {}, "skin": "fair", "eyes": "moss", "freckles": 0.18, "lid": 0.10, "pupil": 0.24},
    {"id": "highborn", "name": "Highborn", "words": "Fine-boned and narrow, a long straight nose: a face for a portrait in a hall.", "shape": {}, "skin": "fair", "eyes": "frost", "lid": 0.17, "pupil": 0.31},
    {"id": "vixen", "name": "Vixen", "words": "Eyes tilted up under heavy lids, a full mouth, a small sharp chin.", "shape": {}, "skin": "fair", "eyes": "lichen"},
    {"id": "doe", "name": "Doe", "words": "Wide soft eyes, a small nose, a gentle jaw. People trust her before they should.", "shape": {}, "skin": "rose", "eyes": "chestnut", "lid": 0.11, "pupil": 0.31},
    {"id": "sunborn", "name": "Sunborn", "words": "Wide-set eyes, a full mouth, a face carved for the long light of the south roads.", "shape": {}, "skin": "brown", "eyes": "sloe", "lid": 0.12, "whites": 0.75},
    {"id": "moonlit", "name": "Moonlit", "words": "Almond eyes that give nothing away, a small mouth, skin like the inside of a shell.", "shape": {}, "skin": "fair", "eyes": "umber"},
    {"id": "saffron", "name": "Saffron", "words": "Great dark eyes under strong brows, and a nose with a proud line to it.", "shape": {}, "skin": "warm", "eyes": "peat"},
    {"id": "wildling", "name": "Wildling", "words": "A wide mouth made for laughing, a broad nose, cheekbones from the hill country.", "shape": {}, "skin": "rose", "eyes": "hazel", "freckles": 0.1},
    {"id": "hardwon", "name": "Hard-won", "words": "A strong jaw, low straight brows, the bridge of a nose that has been broken.", "shape": {}, "skin": "rose", "eyes": "flint", "freckles": 0.12},
