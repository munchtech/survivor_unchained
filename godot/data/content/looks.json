   "cuts": [
    {"id": "long", "name": "Loose", "words": "Long past her shoulders, parted on the left, most of it down her back."},
    {"id": "ponytail", "name": "Tail", "words": "Drawn back off her face and tied high; the tail swings as she moves."},
    {"id": "braid", "name": "Braid", "words": "Tied low at the nape, then one thick plait down her back, out of a blade's way."},
    {"id": "bob", "name": "Bob", "words": "Cut blunt at the chin, parted on the left, falling round her face."},
    {"id": "pixie", "name": "Cropped", "words": "Short, close to the head: nothing for a hand to catch."}
