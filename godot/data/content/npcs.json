         {
          "fact": "beasts.outcome",
          "eq": "allied"
         }
        ]
       }
      ]
     }
    },
    {
     "text": "Clean water, and nothing left in the wood to drink it.",
     "night": false,
     "when": {
      "all": [
       {
        "fact": "stream.clear",
        "eq": true
       },
       {
        "fact": "beasts.outcome",
        "eq": "slaughtered"
       }
      ]
     }
    },
    {
     "text": "Hot stone on you, child. Last I smelled that was the fever year.",
