   "said": [
    {
     "text": "They drank from the stream and fell down.",
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     }
    },
    {
     "text": "I told the Watch. The Watch laughed.",
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     }
    },
    {
     "text": "The stream's clear and Pa says I was right, and I was.",
     "when": {
      "fact": "beasts.outcome",
      "eq": "cured"
     }
    },
    {
     "text": "Somebody killed all the wolves. Even the ones that were only sick.",
     "when": {
      "fact": "beasts.outcome",
      "eq": "slaughtered"
     }
    },
    {
     "text": "Still knocking under our floor. Pa's stopped saying it's moles.",
     "when": {
      "all": [
       {
        "fact": "tam.tock",
        "eq": true
       },
       {
        "fact": "tremor.felt",
        "eq": true
       }
      ]
     }
    },
    {
     "text": "The hill lit up last night and Pa said marsh-lights and it was you.",
     "night": false,
     "once": true,
     "when": {
      "fact": "arena.last.ago",
      "eq": 1
     }
    },
    {
     "text": "Pa says I'm not to watch the hill at night. I watch it.",
     "night": false,
     "when": {
      "fact": "arena.last.ago",
      "eq": 1
     }
    }
   ]
  },
