    "facing": -1.5707963267948966
   },
   "barks": [
    "Salt and iron, friend. Good honest salt."
   ],
   "nightBarks": [
    "I keep the books by candlelight. Helps me not think."
   ],
   "said": [
    {
     "text": "Late. Jory's never late.",
     "night": false,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "exists": true
      }
     }
    },
    {
     "text": "Salt, iron, cloth. Whatever you need, when the wagons come.",
     "night": false,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "exists": true
      }
     }
    },
    {
     "text": "Somebody knows something.",
     "night": false,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "exists": true
      }
     }
    },
    {
     "text": "Every wagon on that road's his, in the dark.",
     "night": true,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "eq": "rescued"
      }
     }
    },
    {
     "text": "Can't sleep. Won't.",
     "night": true,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "exists": true
      }
     }
    },
    {
     "text": "Jory hated the dark. Hated it. Slept with a candle till he was fourteen.",
     "night": true,
     "when": {
      "not": {
       "fact": "caravan.survivors",
       "eq": "rescued"
      }
     }
    },
    {
     "text": "Jory's asleep in Rook's good room. I keep going to look.",
     "night": false,
     "when": {
      "fact": "caravan.survivors",
      "eq": "rescued"
     }
    },
    {
     "text": "He sleeps with the lamp lit. So do I, now.",
     "night": true,
     "when": {
      "fact": "caravan.survivors",
      "eq": "rescued"
     }
    },
    {
     "text": "Coyle and Nephew, the new sign was going to say. Coyle and—",
     "night": false,
     "when": {
      "fact": "caravan.survivors",
      "eq": "dead"
     }
    },
    {
     "text": "Mister Coyle, he calls me. In my own shop.",
     "night": false,
     "when": {
      "fact": "jory.knows_be",
      "eq": true
     }
    }
   ]
  },
