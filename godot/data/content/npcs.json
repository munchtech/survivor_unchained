    {
     "text": "Forge is lit. Don't come in.",
     "night": true,
     "when": {
      "fact": "nell.buried",
      "eq": true
     }
    },
    {
     "text": "Hill went gold last night. Open lamps. Not mine.",
     "night": false,
     "when": {
      "all": [
       {
        "fact": "arena.last.ago",
        "eq": 1
       },
       {
        "fact": "arena.last.people",
        "eq": "lamplings"
       }
      ]
     }
    },
    {
     "text": "Girl's first new boots. Irons paid for 'em.",
     "night": false,
     "when": {
      "not": {
       "fact": "nell.told",
       "exists": true
      }
     }
    },
    {
     "text": "Told her: walk where it's lit. Nothing on that road you can't see.",
     "night": false,
     "when": {
      "not": {
       "fact": "nell.told",
       "exists": true
      }
     }
    },
    {
     "text": "Pedlar says the Kiln road's dry. Good.",
