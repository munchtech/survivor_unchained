   "spot": {
    "x": 33.5,
    "z": 3.6,
    "facing": -1.5707963267948966
   },
   "barks": [
    "Mind the east road after dark."
   ],
   "nightBarks": [
    "Hear that? No. Neither do I. That's what worries me.",
    "One more, then I sleep."
   ],
   "said": [
    {
     "text": "They're not hunting. They're running.",
     "night": false,
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     }
    },
    {
     "text": "Something's got the whole wood on edge.",
     "night": false,
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     }
    },
    {
     "text": "The Pack's loud tonight.",
     "night": true,
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "eq": "slaughtered"
      }
     }
    },
    {
     "text": "Somewhere out there an old wolf's coughing. Listen.",
     "night": true,
     "when": {
      "not": {
       "fact": "beasts.outcome",
       "exists": true
      }
     }
    },
    {
     "text": "Hear that? They're hunting again. Deer.",
     "night": true,
     "when": {
      "fact": "beasts.outcome",
      "eq": "cured"
     }
    },
    {
     "text": "The Pack's lying up by the east wall. Leave them be.",
     "night": true,
     "when": {
      "fact": "beasts.outcome",
      "eq": "allied"
     }
    },
    {
     "text": "Nothing calls in the Hollow now.",
     "night": true,
     "when": {
      "fact": "beasts.outcome",
      "eq": "slaughtered"
     }
    }
   ]
  },
