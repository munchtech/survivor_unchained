   "nightBarks": [
    "Moon's up. Good for picking. Bad for knees.",
    "Mind the nettles in the dark.",
    "Night air's full of things. Some of them are herbs.",
    "Nightshade's out. So are the idiots."
   ],
   "said": [
    {
     "text": "The animals were never like this. Never.",
     "night": false,
     "when": {
      "not": {
       "fact": "stream.clear",
       "eq": true
      }
     }
    },
    {
     "text": "The water tastes wrong this year.",
     "night": false,
     "when": {
      "not": {
       "fact": "stream.clear",
       "eq": true
      }
     }
    },
    {
     "text": "Water's sweet again. I'd forgotten it could be.",
