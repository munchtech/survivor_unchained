   "barks": [
    "Beds are dry and the stew's hot. That's more than most can say.",
    "Wipe your boots.",
    "If you're bleeding, bleed outside.",
    "Rooms upstairs by the night. By the hour, ask Sella."
   ],
   "nightBarks": [
    "Lamps stay lit till the last one's in.",
    "Bed's warm if you want it. Stew's gone.",
    "Quietly, now. People are sleeping.",
    "Going up to Sella's? Wipe your boots twice. She's particular about her floor and nothing else."
   ],
   "said": [
    {
     "text": "Harlan's not eating. I've sent bread. He's sent it back.",
     "night": false,
     "when": {
