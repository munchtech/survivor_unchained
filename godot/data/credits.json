          "entries": [
            {
              "name": "Adobe Mixamo",
              "work": false,
              "text": "motion, used in the game under Mixamo's terms; the raw files are not distributed",
              "links": [],
              "lines": [
                "The heroine's Crashing Leap: \"Standing Melee Run Jump Attack\", retargeted and retimed.",
                "The townsfolk: a feminine walk; a weight-shift idle; \"General Conversation\" talk; sitting on a chair and on the floor; picking up.",
                "All are retargeted to the kit's bodies."
              ]
            },
            {
              "name": "NVIDIA Kimodo",
              "work": false,
              "text": "(Kimodo-SOMA-RP): generated motion for the townsfolk's men's walk, women's talk, arms crossed, cheer, wave and work at a table. Kimodo is licensed by NVIDIA Corporation under the NVIDIA Open Model License.",
              "links": [],
              "lines": []
            },
            {
              "name": "Reallusion AccuRIG",
              "work": false,
              "text": "rigged the heroine's body. Her weights were then folded onto our own skeleton; no Reallusion content ships.",
              "links": [],
              "lines": []
            }
          ]
        }
      ]
