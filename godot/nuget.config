<?xml version="1.0" encoding="utf-8"?>
<!-- Godot's SDK packages ship with the engine; nuget.org for the rest.
     GODOT_NUPKGS is set by tools/godot/run.sh (the engine's GodotSharp/Tools/nupkgs). -->
<configuration>
  <packageSources>
    <add key="godot" value="%GODOT_NUPKGS%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
