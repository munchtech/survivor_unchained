<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's rules, tested without the engine: everything under
       ../logic is plain C# (no Godot types), compiled here as it is in the
       game. Run with `dotnet test godot/tests`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SurvivorUnchained.Tests</RootNamespace>
    <!-- Keep the simulations' full samples without the Debug compiler overhead. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../logic/**/*.cs" LinkBase="logic" />
    <!-- The balance harness's bots and probes (not its command line), for the balance tests. -->
    <Compile Include="../balance/Harness/**/*.cs" LinkBase="balance" />
    <!-- The Lamps board's geometry (plain C#; src/Ui/LampBoard.cs draws it). -->
    <Compile Include="../src/Audio/SoundBankData.cs" LinkBase="src" />
    <Compile Include="../src/Audio/LeadRule.cs" LinkBase="src" />
    <Compile Include="../src/Fx/HitStopClassifier.cs" LinkBase="src" />
    <Compile Include="../src/Ui/LampBoardModel.cs" LinkBase="src" />
    <Compile Include="../src/Ui/LampNav.cs" LinkBase="src" />
    <Compile Include="../src/Ui/LampAsk.cs" LinkBase="src" />
    <Compile Include="../src/Actors/SwingRecover.cs" LinkBase="src" />
    <Compile Include="../src/QuitGuard.cs" LinkBase="src" />
    <Compile Include="../src/Ui/LampPrompts.cs" LinkBase="src" />
    <Compile Include="../src/Game/KeyMap.cs" LinkBase="src" />
    <Compile Include="../src/Ui/ResolveMotion.cs" LinkBase="src" />
    <Compile Include="../src/Ui/LevelCardModel.cs" LinkBase="src" />
    <Compile Include="../src/Ui/GlyphPaths.cs" LinkBase="src" />
    <Compile Include="../src/Fx/HitsPlace.cs" LinkBase="src" />
    <Compile Include="../src/Fx/FeelRules.cs" LinkBase="src" />
    <Compile Include="../src/Fx/TeleRank.cs" LinkBase="src" />
    <Compile Include="../src/Ui/SeatCostModel.cs" LinkBase="src" />
    <Compile Include="../src/Ui/RoadKeep.cs" LinkBase="src" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>
</Project>
