<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's rules, tested without the engine: everything under
       ../logic is plain C# (no Godot types), compiled here as it is in the
       game. Run with `dotnet test godot/tests`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SurvivorUnchained.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../logic/**/*.cs" LinkBase="logic" />
    <!-- The balance harness's bots and probes (not its command line), for the balance tests. -->
    <Compile Include="../balance/Harness/**/*.cs" LinkBase="balance" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>
</Project>
