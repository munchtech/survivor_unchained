<Project Sdk="Microsoft.NET.Sdk">
  <!-- A measuring tool for docs/bestiary, not part of the game: one kind of
       creature (or one mix) at a time against one loadout, driven by the
       balance lab's plain and deft arena bots, counting time to kill and
       damage taken. Run from the repo root (the logic finds godot/data from
       the working directory):
         dotnet run (project docs/bestiary/probe, Release), arguments: out-dir, seeds, seconds.
       See docs/bestiary/probe/README.md for what it measures and how. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>SurvivorUnchained.Tests</RootNamespace>
    <NoWarn>CS8618;CS8602;CS8604;CS1998;CS0162;CS8600;CS8603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../godot/logic/**/*.cs" LinkBase="logic" />
  </ItemGroup>
</Project>
