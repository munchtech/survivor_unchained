  "nodes": {
   "first": {
    "id": "first",
    "text": [
     {
      "when": {
       "bg": "hunter"
      },
      "text": "You walk like someone who's followed a thing to its den. Hunter? Then you've seen it too, out there. They're not hunting. They're running. Maeca. Barefoot, before you ask."
     },
     {
      "when": {
       "hasTag": "wolf_pelts"
      },
      "text": "That cloak's made of wolves. I can smell it from here, and so can they. Maeca Barefoot. What do you want?"
     },
     {
      "text": "Another blade for Holloway's bounty? The wolves aren't the problem. They're what the problem looks like from the road. Maeca Barefoot, of the Ashford garrison. What's left of it."
     }
    ],
    "effects": [
     {
      "quest": {
       "id": "beasts",
       "status": "active",
       "entry": "maeca_theory"
      }
     }
    ],
    "choices": [
     {
      "text": "What's driving them out?",
      "goto": "driving"
     },
     {
      "text": "Their tracks are wrong. They're dragging their back legs.",
      "when": {
       "knows": "beastlore"
      },
      "badge": "Beastlore",
      "once": "tracks",
      "goto": "tracks"
     },
     {
      "text": "It's the stream. Ember slurry from the Dig.",
      "when": {
       "knows": "root_cause"
      },
      "once": "truth",
      "goto": "truth"
     },
     {
      "text": "Can the Pack be spoken to?",
