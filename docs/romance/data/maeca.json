      "goto": "speak"
     },
     {
      "text": "Where can I find you?",
      "once": "where",
      "goto": "where"
     },
     {
      "text": "You know them, don't you. The Kerchiefs.",
      "show": {
       "any": [
        {
         "quest": {
          "id": "caravan",
