   "say_calling": {
    "id": "say_calling",
    "text": [
     {
      "when": {
       "archetype": "warden"
      },
      "text": "A shield. Good. Don't raise it in the Hollow. To a wolf a raised arm's a raised arm."
     },
     {
      "when": {
       "archetype": "reaver"
      },
      "text": "Leave the big blade at the Blind if you go near the Hollow. They can smell iron that's been used."
     },
     {
      "when": {
       "archetype": "arcanist"
      },
      "text": "Whatever it is you burn with, don't burn it in the Hollow. Fire's the one thing they all remember."
     },
     {
      "when": {
       "archetype": "stalker"
      },
      "text": "You move like you've done this. Quiet feet. ...Pity about the boots."
     },
     {
      "text": "You move like you've done this. Quiet feet. ...Pity about the boots."
     }
    ],
