{
  "autoCompactWindow": 250000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/munch/Desktop/survivorsunchained/tools/hooks/spawn_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/munch/Desktop/survivorsunchained/tools/hooks/read_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/munch/Desktop/survivorsunchained/tools/hooks/noisy_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/munch/Desktop/survivorsunchained/tools/hooks/ctx_budget.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/munch/Desktop/survivorsunchained/tools/hooks/ctx_budget.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoCompactEnabled": true,
  "precomputeCompactionEnabled": true
}
